{
  "name": "glogger",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Glogger-Team/glogger.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check:grids": "node scripts/check-grid-standards.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "bash scripts/release-build.sh",
    "tauri:build:experimental": "tauri build --config src-tauri/tauri.experimental.conf.json",
    "tauri:dev:experimental": "tauri dev --config src-tauri/tauri.experimental.conf.json",
    "version:bump": "bash scripts/bump-version.sh",
    "release": "bash scripts/release.sh",
    "changelog": "bash scripts/generate-changelog.sh",
    "survey-test": "cd src-tauri && cargo test --lib survey::replay_tests::accuracy_report -- --ignored --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.13",
    "vue-data-ui": "^3.17.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
