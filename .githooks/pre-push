#!/bin/sh
# Pre-push: enforce game-interaction hard lines (docs/research/glogger-game-interaction-limits.md).
# Skippable in emergencies with GLOGGER_SKIP_CONSTRAINTS=1, but never silently —
# CI also runs the check.
# Portable entrypoint: execs python3 if present else python, so the hook starts
# on machines with either interpreter (a python3-only shebang would fail before
# the fallback could run).
if [ -n "$GLOGGER_SKIP_CONSTRAINTS" ]; then
  echo "[glogger] WARNING: constraint check skipped via GLOGGER_SKIP_CONSTRAINTS" >&2
  exit 0
fi
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/scripts/check-glogger-constraints.py"
else
  exec python "$ROOT/scripts/check-glogger-constraints.py"
fi
