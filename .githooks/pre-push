#!/usr/bin/env python3
"""Pre-push: enforce game-interaction hard lines (docs/research/glogger-game-interaction-limits.md).

Skippable in emergencies with GLOGGER_SKIP_CONSTRAINTS=1, but never silently —
CI also runs the check.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path


def main() -> int:
    if os.environ.get("GLOGGER_SKIP_CONSTRAINTS"):
        print(
            "[glogger] WARNING: constraint check skipped via GLOGGER_SKIP_CONSTRAINTS",
            file=sys.stderr,
        )
        return 0
    root = Path(__file__).resolve().parent.parent
    script = root / "scripts" / "check-glogger-constraints.py"
    interp = shutil.which("python3") or shutil.which("python")
    if not interp:
        print("[glogger] ERROR: no python3/python interpreter found", file=sys.stderr)
        return 1
    return subprocess.run([interp, str(script)]).returncode


if __name__ == "__main__":
    sys.exit(main())
