#!/bin/sh
# Portable entrypoint: execs python3 if present else python (a python3-only
# shebang would fail on machines with only `python` before any fallback runs).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if command -v python3 >/dev/null 2>&1; then
  exec python3 "$ROOT/.githooks/commit-msg.py" "$@"
else
  exec python "$ROOT/.githooks/commit-msg.py" "$@"
fi
