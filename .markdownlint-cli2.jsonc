// markdownlint-cli2 config: gate hand-maintained docs only (line-length 120 —
// prose and URLs exceed 80 routinely). Generated/session files (CHANGELOG,
// RELEASE_NOTES, HANDOFF) are excluded: linting them guarantees a red gate
// on day one and teaches the linter to be ignored.
{
  // MD013/line-length at 120, not 80.
  "MD013": {
    "line_length": 120
  },
  // MD024 (duplicate headings) fires on legit repeated section names in long
  // reference docs; MD060 (table style) fires on existing aligned tables.
  "MD024": false,
  "MD060": false,

  "globs": ["**/*.md"],
  "ignores": [
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "HANDOFF.md",
    "HANDOFF-ADDENDUM.md",
    "node_modules/**"
  ]
}
